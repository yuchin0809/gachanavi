# ------------------------------------------------------------------
# GachaNavi 環境変数のサンプル
#
# このファイルをコピーして .env.local を作り、値を設定してください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みです。実際の値（特に秘密鍵）は絶対にコミットしないでください。
# ------------------------------------------------------------------

# 使用するデータソース: mock（既定・Firebase 不要） / firestore
DATA_SOURCE=mock

# ------------------------------------------------------------------
# サーバー用（Firebase Admin SDK）※ 秘密情報。NEXT_PUBLIC_ を付けないこと
# Firebase コンソール > プロジェクトの設定 > サービス アカウント > 「新しい秘密鍵を生成」
# でダウンロードした JSON の project_id / client_email / private_key を設定します。
# private_key は改行を \n にした1行の文字列を "" で囲んで記入します。
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ローカルの Firestore エミュレータに接続する場合のみ設定（サービスアカウント不要）
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ------------------------------------------------------------------
# ブラウザ用（Firebase Client SDK）
# Firebase コンソール > プロジェクトの設定 > 全般 > マイアプリ（ウェブアプリ）の firebaseConfig の値。
# 公開される値ですが、プロジェクトごとに異なるためコードには書かず環境変数で渡します。
# 現時点では未使用（将来のログイン機能で使用）。
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# 将来 Google Maps を導入する場合の APIキー（現在は未使用）
# ------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
