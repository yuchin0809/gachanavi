# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# firebase（サービスアカウントの鍵ファイルは絶対にコミットしない）
*-firebase-adminsdk-*.json
service-account*.json
serviceAccount*.json
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# データ収集のキャッシュ（scripts/collect）
/.collect-cache/
__pycache__/

# 収集の作業ファイル（生データは raw/*.jsonl.gz をコミット）
/data/collected/raw/*.jsonl
/data/collected/logs/

# カタログ索引のローカル出力（npm run catalog:build）
/.catalog-build/
